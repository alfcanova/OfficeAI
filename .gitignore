# ============================================================================
# OfficeAI - .gitignore
# Versiona a ESTRUTURA de diretorios (via .gitkeep) + codigo-fonte e docs.
# Runtimes (lib/<tool>), modelos, dados (var/), logs e credenciais ficam de
# fora (auto-contido no disco; instaladores recriam tudo localmente).
# ============================================================================

# Credenciais / segredos
etc/Tokens.sh
.env
*.env
!*.env.example
etc/.secrets/

# Runtimes instalados em lib/<tool>: mantem apenas as bibliotecas bash
# (lib/*.sh) e a estrutura de diretorios (via .gitkeep).
lib/*
!lib/*.sh
!lib/languages/
!lib/npm/
!lib/uv-tools/
!lib/bin/
lib/languages/*
!lib/languages/.gitkeep
lib/npm/*
!lib/npm/.gitkeep
lib/uv-tools/*
!lib/uv-tools/.gitkeep
lib/bin/*
!lib/bin/.gitkeep

# Modelos e dados (mantem estrutura)
ollama_models/
share/models/*
!share/models/.gitkeep
share/ollama-models/*
!share/ollama-models/.gitkeep

# HOME virtual e estado (mantem estrutura)
var/*
!var/.gitkeep
!var/home/
var/home/*
!var/home/.gitkeep

# Logs e backups (mantem estrutura)
logs/*
!logs/.gitkeep
*.log
bak/

# Executaveis gerados (mantem estrutura; regenerados pelo instalador)
bin/*
!bin/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Node
node_modules/

# Rust / Go / Caches
target/
*.rs.bk

# Sistema / Editores
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/